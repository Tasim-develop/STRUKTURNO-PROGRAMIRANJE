#include <iostream>
using namespace std;

bool blag(int broj) {
    while (broj > 0) {
        int cifra = broj % 10;

        if (cifra % 2 != 0)
            return false;

        broj /= 10;
    }

    return true;
}

int main() {
    int m, n;
    cin >> m >> n;

    for (int i = m; i <= n; i++) {
        if (blag(i)) {
            cout << i;
            return 0;
        }
    }

    cout << "NE";

    return 0;
}
